      bins mulhsu_one_two= binsof(cp_op.mulhsu) && binsof(cp_rs1_class.one) && binsof(cp_rs2_class.two);
      bins mulhsu_one_zero= binsof(cp_op.mulhsu) && binsof(cp_rs1_class.one) && binsof(cp_rs2_class.zero);
