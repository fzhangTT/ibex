    cp_csr: coverpoint v_cp_csr { bins mstatus= {0}; bins misa= {1}; bins mie= {2}; bins mtvec= {3}; bins mcounteren= {4}; bins mstatush= {5}; bins menvcfg= {6}; bins menvcfgh= {7}; ignore_bins na = {-1}; }
