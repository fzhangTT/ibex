      bins bgeu_yes_slt_ugt= binsof(cp_op.bgeu) && binsof(cp_taken.yes) && binsof(cp_cmp_class.slt_ugt);
      bins blt_no_both_msb_eq= binsof(cp_op.blt) && binsof(cp_taken.no) && binsof(cp_cmp_class.both_msb_eq);
