      bins ctz_zero= binsof(cp_op.ctz) && binsof(cp_operand.zero);
    }
    cr_op_result: cross cp_op, cp_result {
      bins clz_other= binsof(cp_op.clz) && binsof(cp_result.other);
      bins clz_r1= binsof(cp_op.clz) && binsof(cp_result.r1);
