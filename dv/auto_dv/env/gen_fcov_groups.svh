    cp_wrap: coverpoint v_cp_wrap { bins add_carry= {0}; bins add_pos_ovf= {1}; bins add_neg_ovf= {2}; bins sub_borrow= {3}; bins sub_ovf= {4}; bins none= {5}; ignore_bins na = {-1}; }
    cr_op_eq: cross cp_op, cp_eq_operands {
