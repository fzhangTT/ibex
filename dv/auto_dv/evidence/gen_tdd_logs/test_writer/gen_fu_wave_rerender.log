          "gen_mul_timing_cg.cr_op_delta_clean.mulhsu_d2", "gen_mul_timing_cg.cr_op_delta_clean.mulhu_d2"}
fails = []
def expect(cond, msg):
    print(("  ok    " if cond else "  FAIL  ") + msg)
    if not cond: fails.append(msg)
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def git(*a): return subprocess.check_output(["git", "-C", str(CLONE), *a], text=True)
def bins_of(text): return re.findall(r"^  - (\S+)$", text, re.M)
def nothit_of(text): return dict(re.findall(r"^# not_hit (\S+): (.*)$", text, re.M))

head = git("rev-parse", "HEAD").strip()
