"""Hand B edits: the wave re-renders. Every removed bin and its count come from the committed census; the class
of each reason is the DV Lead's ruling (TASKS 2026-09-05T10:08:17Z). Idempotent: refuses to insert a key twice."""
import ast, re, subprocess, sys
from pathlib import Path
CLONE = Path("/localdev/fzhang/ws/ibex-challenge")
CENSUS = CLONE / "dv/auto_dv/evidence/gen_wave_4017573/gen_wave_census.txt"
NOTHIT = CLONE / "dv/auto_dv/evidence/gen_wave_4017573/gen_wave_nothit.txt"
CITE = "the wave at 4017573 (gen_wave_4017573/gen_wave_census.txt)"

def census():
    out, ent = {}, None
    for line in CENSUS.read_text().splitlines():
        m = re.match(r"^=== (gen_test_\w+): (\d+) runs.*declared (\d+) \| EVERY (\d+)\s+SOME (\d+)\s+NEVER (\d+)", line)
        if m: ent = m.group(1); out[ent] = {"declared": int(m.group(3)), "some": int(m.group(5)), "bins": {}}; continue
        m = re.match(r"^\s+(\d+)/40\s+(gen_\S+)( \[CROSS LEG\])?\s*$", line)
        if m and ent: out[ent]["bins"][m.group(2)] = (int(m.group(1)), bool(m.group(3)))
    for e, d in out.items():
        assert len(d["bins"]) == d["some"], (e, len(d["bins"]), d["some"])
    return out

def nothit_zca():
    t = NOTHIT.read_text()
    blk = t.split("=== gen_test_cmp_zca:")[1]
    decl = re.findall(r"^\s+40/40\s+(gen_\S+)$", blk, re.M)
    never = re.findall(r"^\s+0/40\s+(gen_\S+)\s+<-- NEVER", blk, re.M)
    assert len(decl) == 21 and never == ["gen_cmp_imm_edges_cg.cp_cj_off.self"], (len(decl), never)
    return decl, never[0]

LABEL_LEGS = {"gen_div_ops_cg.cr_op_divisor.divu_pos_rand", "gen_div_ops_cg.cr_op_divisor.remu_pos_rand",
              "gen_div_ops_cg.cr_op_divisor.div_pos_rand", "gen_div_ops_cg.cr_op_divisor.rem_pos_rand"}
UNDIAG = {"gen_div_timing_cg.cp_delta.d2", "gen_div_timing_cg.cr_dit_div0_delta.dit0_div0_d2",
          "gen_mul_timing_cg.cr_op_delta_clean.mulhsu_d2", "gen_mul_timing_cg.cr_op_delta_clean.mulhu_d2"}
FOLLOWS = {"gen_mul_ops_cg.cr_op_rs1.c_mul_p16": "gen_mul_ops_cg.cp_rs1_class.p16",
           "gen_mul_ops_cg.cr_op_rs1.c_mul_two": "gen_mul_ops_cg.cp_rs1_class.two",
           "gen_mul_ops_cg.cr_op_rs1.c_mul_one": "gen_mul_ops_cg.cp_rs1_class.one",
           "gen_cmp_zcmp_hazard_cg.cr_ft_kind.popretz_ft_cm_cm_pop": "gen_cmp_zcmp_hazard_cg.cp_hazard.popretz_ft_cm",
           "gen_div_timing_cg.cr_dit_div0_delta.dit0_div0_d2": "gen_div_timing_cg.cp_delta.d2"}

def reason(b, n, ent_bins):
    if b in LABEL_LEGS:
        return (f"generator label defect, not seed-dependent: hit at {n} of 40 seeds in {CITE}; gen_mul_div_prog.py draws a "
                "pos_rand divisor by sign alone while the sampler's single-class rule (div_divisor_cls: the named values, then "
                "eq_dividend, then abs_gt_dividend, then the sign class) books a draw whose magnitude exceeds the dividend as "
                "abs_gt_dividend, so the label is not the bin; the fix owed is a draw that rejects the classifier's other classes, "
                "proven against the sampler's rule and never the generator's mirror, then a fresh forty-seed measurement at that "
                "fix's commit")
    if b in UNDIAG:
        return (f"seed-dependent by measurement, cause undiagnosed: hit at {n} of 40 seeds in {CITE}; one of the four delta-2 "
                "timing bins (mul_div cp_delta.d2 and cr_dit_div0_delta.dit0_div0_d2, mul_mul cr_op_delta_clean.mulhsu_d2 and "
                "mulhu_d2) that get one diagnosis together; PLANNED in traceability, credited from the merged report")
    s = f"seed-dependent: hit at {n} of 40 seeds in {CITE}, so this test does not guarantee it per run"
    if b in FOLLOWS:
        comp = FOLLOWS[b]; cn = ent_bins[comp][0]
        s += f"; the cross follows its component {comp.split('.', 1)[1]}, itself under the bar at {cn} of 40"
    return s + "; PLANNED in traceability, credited from the merged report"

def dict_node(src):
    tree = ast.parse(src)
    for n in ast.walk(tree):
        if isinstance(n, ast.Assign) and any(isinstance(x, ast.Name) and x.id == "bins_not_hit" for x in n.targets):
            return n
    return None

def entry_lines(key, why):
    return [f'        "{key}":', f'            "{why}",']

def add_entries(path, new):
    """Insert sorted entries into an existing dict without touching its other lines, or create the dict after not_built."""
    src = path.read_text(); lines = src.split("\n")
    node = dict_node(src)
    for k in new:
        assert f'"{k}"' not in src, f"{path.name}: {k} already present"
    if node is not None:
        keys = [(k.value, k.lineno) for k in node.value.keys]
        close = node.end_lineno  # the line holding the closing brace
        groups = {}              # before_line_1based -> lines, keys in sorted order within a group
        for k in sorted(new):
            after = [ln for kv, ln in keys if kv > k]
            groups.setdefault(min(after) if after else close, []).extend(entry_lines(k, new[k]))
        for at in sorted(groups, reverse=True):
            lines[at - 1:at - 1] = groups[at]
    else:
        nb = [i for i, l in enumerate(lines) if re.match(r"^    not_built = ", l)]
        assert len(nb) == 1, path.name
        i = nb[0]
        # a one-line not_built; the dict goes right after it with the template's comment
        assert lines[i].rstrip().endswith("}"), (path.name, lines[i])
        block = ["    # bins this test does not guarantee per run, with the reason and its class (gen_test_template.bins_not_hit)",
                 "    bins_not_hit = {"]
        for k in sorted(new):
            block += entry_lines(k, new[k])
        block.append("    }")
        lines[i + 1:i + 1] = block
    path.write_text("\n".join(lines))
    node2 = dict_node(path.read_text()); got = {k.value: v.value for k, v in zip(node2.value.keys, node2.value.values)}
    for k, v in new.items():
        assert got[k] == v, k
    assert [k.value for k in node2.value.keys] == sorted(k.value for k in node2.value.keys), f"{path.name}: dict not sorted"
    return len(node2.value.keys)

def remove_entries(path, drop, replace):
    src = path.read_text(); lines = src.split("\n"); node = dict_node(src)
    kv = {k.value: (k, v) for k, v in zip(node.value.keys, node.value.values)}
    cuts = []
    for k in drop:
        kn, vn = kv[k]; assert vn.lineno == kn.lineno + 1 and vn.end_lineno == vn.lineno, k
        cuts.append((kn.lineno, vn.end_lineno))
    for k, why in replace.items():
        kn, vn = kv[k]; assert vn.end_lineno == vn.lineno, k
        lines[vn.lineno - 1] = f'            "{why}",'
    for a, b in sorted(cuts, reverse=True):
        del lines[a - 1:b]
    path.write_text("\n".join(lines))
    node2 = dict_node(path.read_text()); got = {k.value: v.value for k, v in zip(node2.value.keys, node2.value.values)}
    assert not (set(drop) & set(got)) and all(got[k] == w for k, w in replace.items())
    return len(got)

def main():
    c = census()
    ENTRIES = {"gen_test_cmp_zcb": "cmp_zcb", "gen_test_cmp_zcmp_basic": "cmp_zcmp_basic", "gen_test_mul_div": "mul_div",
               "gen_test_isa_shift": "isa_shift", "gen_test_mul_mul": "mul_mul", "gen_test_pmp_csr_warl": "pmp_csr_warl"}
    for ent, short in ENTRIES.items():
        bins = c[ent]["bins"]
        new = {b: reason(b, n, bins) for b, (n, _) in bins.items()}
        total = add_entries(CLONE / f"dv/auto_dv/tests/gen_test_{short}.py", new)
        print(f"{ent}: +{len(new)} not_hit -> {total} entries")
    decl, never = nothit_zca()
    zca = CLONE / "dv/auto_dv/tests/gen_test_cmp_zca.py"
    fix = {never: ("stimulus: this program emits no c.j or c.jal with offset 0, so the bin is 0 of 40 in the wave at 4017573 "
                   "(gen_wave_4017573/gen_wave_nothit.txt); entry-scoped, not exclusive with termination: a zero-offset compressed "
                   "jump is the park-here idiom that other entries retire (398 merged hits in round 0)")}
    total = remove_entries(zca, decl, fix)
    print(f"gen_test_cmp_zca: -{len(decl)} not_hit, 1 reason replaced -> {total} entries")
    for short in list(ENTRIES.values()) + ["cmp_zca"]:
        t = f"gen_test_{short}"
        r = subprocess.run([sys.executable, str(CLONE / "dv/auto_dv/tests/gen_fcov_manifest.py"), "--test-module",
                            str(CLONE / f"dv/auto_dv/tests/{t}.py"), "--test", t, "--write"], cwd=str(CLONE),
                           text=True, capture_output=True, env={"PATH": "/usr/bin:/bin"})
        last = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else r.stderr.strip().splitlines()[-1]
        print(f"  render {t}: exit {r.returncode}: {last}")
        if r.returncode: print(r.stderr[-800:]); sys.exit(1)

if __name__ == "__main__":
    main()
