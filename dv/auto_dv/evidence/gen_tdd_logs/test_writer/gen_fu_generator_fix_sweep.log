"""Grade the post-fix sweep from the run directories, independent of any report."""
import hashlib, os, re, sys, collections

O = "/proj_soc/user_dev/fzhang/ibex_dv_out/regress_gsfix2/runs"
FIXROOT = "/proj_soc/user_dev/fzhang/ibex_dv_probe/gensweep_fix"
CLONE = "/localdev/fzhang/ws/ibex-challenge"

SEVEN = [
    "gen_bit_zba_zbb_ops_cg.cr_op_rs1.zext_h_pos_rand",
    "gen_bit_zba_zbb_ops_cg.cr_op_rs1.max_neg_rand",
    "gen_bit_zba_zbb_ops_cg.cr_op_rs1.sh3add_neg_rand",
    "gen_bit_count_cg.cr_op_result.cpop_other",
    "gen_bit_zba_zbb_ops_cg.cr_op_rs1.andn_pos_rand",
    "gen_bit_zba_zbb_ops_cg.cr_op_rs1.xnor_pos_rand",
    "gen_bit_zba_zbb_ops_cg.cr_op_rs1.orn_pos_rand",
]

def md5(p):
    h = hashlib.md5()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 16), b""):
            h.update(b)
    return h.hexdigest()

def head_fields(p):
    d = {}
    with open(p, encoding="utf-8", errors="replace") as f:
        for line in f:
            m = re.match(r"^([a-z_]+): (.*)$", line.rstrip("\n"))
            if m and m.group(1) in ("test", "seed", "verdict", "reason", "evidence"):
                d[m.group(1)] = m.group(2).strip().strip("'")
            if len(d) == 5:
                break
    return d

runs = sorted(os.listdir(O))
by_test = collections.defaultdict(list)
prov_bad = []
bins = collections.defaultdict(dict)   # test -> bin -> {seed: (state,count)}
manifest_md5 = collections.defaultdict(set)

for r in runs:
    d = os.path.join(O, r)
    res = os.path.join(d, "result.yaml")
    if not os.path.exists(res):
        prov_bad.append((r, "no result.yaml")); continue
    f = head_fields(res)
    test, seed = f["test"], int(f["seed"])
    by_test[test].append((seed, f["verdict"], f["reason"]))
    cmd = open(os.path.join(d, "run_cmd.sh"), encoding="utf-8", errors="replace").read()
    paths = set(re.findall(r"/proj_soc/user_dev/fzhang/ibex_dv_probe/\w+", cmd))
    if paths != {FIXROOT}:
        prov_bad.append((r, "roots " + ",".join(sorted(paths))))
    mu = os.path.join(d, "fcov_manifest_used.yaml")
    if os.path.exists(mu):
        manifest_md5[test].add(md5(mu))
    fc = os.path.join(d, "fcov_check.log")
    if os.path.exists(fc):
        for line in open(fc, encoding="utf-8", errors="replace"):
            m = re.match(r"^FCOV-EXPECTATION: (\S+) = (HIT|UNHIT|ABSENT|NOT_BUILT)(?: \(count=(\d+)\))?", line)
            if m:
                bins[test][m.group(1)] = bins[test].get(m.group(1), {})
                bins[test][m.group(1)][seed] = (m.group(2), int(m.group(3) or 0))

print("=== provenance ===")
print("runs:", len(runs), "  provenance problems:", len(prov_bad))
for r, why in prov_bad[:10]:
    print("  BAD", r, why)
for t in sorted(manifest_md5):
    print(f"  {t}: fcov_manifest_used.yaml md5 set = {sorted(manifest_md5[t])}")

print()
print("=== verdicts ===")
for t in sorted(by_test):
    rows = by_test[t]
    npass = sum(1 for _, v, _ in rows if v == "PASS")
    print(f"{t}: {len(rows)} runs, {npass} PASS, {len(rows)-npass} FAIL")
    reasons = collections.Counter(rs for _, v, rs in rows if v != "PASS")
    for rs, n in reasons.most_common():
        print(f"    FAIL x{n}: {rs}")

print()
print("=== the seven thin bins, post-fix ===")
bt = bins.get("gen_test_bit_ratified", {})
seeds_bt = sorted({s for b in bt.values() for s in b})
print("seeds carrying a bin report:", len(seeds_bt))
for b in SEVEN:
    per = bt.get(b, {})
    unhit = sorted(s for s, (st, _) in per.items() if st != "HIT")
    counts = sorted(c for st, c in per.values() if st == "HIT")
    lo = counts[0] if counts else 0
    hi = counts[-1] if counts else 0
    print(f"  {b:52s} reported {len(per):2d}  UNHIT {len(unhit):2d}  count min/max {lo}/{hi}")
    if unhit:
        print("      unhit seeds:", " ".join(str(s) for s in unhit[:12]))

print()
print("=== every bin unhit on any seed, per test ===")
for t in sorted(bins):
    tot = len(bins[t])
    nseeds = len({s for b in bins[t].values() for s in b})
    bad = {b: sorted(s for s, (st, _) in per.items() if st != "HIT") for b, per in bins[t].items()}
    bad = {b: v for b, v in bad.items() if v}
    print(f"{t}: {tot} declared bins over {nseeds} seeds; {len(bad)} bin(s) missed on at least one seed")
    for b, ss in sorted(bad.items(), key=lambda kv: (-len(kv[1]), kv[0])):
        print(f"    {b:60s} unhit on {len(ss):2d} seed(s)")

---- integrity.py (b8005d90a5b9) ----------------------------------------
"""Run integrity over the post-fix sweep: no failure mechanism anywhere but the coverage check."""
import os, re, collections
O = "/proj_soc/user_dev/fzhang/ibex_dv_out/regress_gsfix2/runs"
agg = collections.Counter()
per = collections.defaultdict(collections.Counter)
missing = []
for r in sorted(os.listdir(O)):
    p = os.path.join(O, r, "result.yaml")
    if not os.path.exists(p):
        missing.append(r); continue
    txt = open(p, encoding="utf-8", errors="replace").read()
    test = re.search(r"^test: (\S+)", txt, re.M).group(1)
    def num(pat):
        m = re.search(pat, txt, re.M)
        return int(m.group(1)) if m else -1
    uvm_e = num(r"^  ERROR: (\d+)")
    uvm_f = num(r"^  FATAL: (\d+)")
    cf = num(r"^  failed: (\d+)")
    cp = num(r"^  passed: (\d+)")
    rounds = num(r"^  rounds: (\d+)")
    to = re.search(r"^timed_out: (\S+)", txt, re.M).group(1)
    fin = re.search(r"^finish_seen: (\S+)", txt, re.M).group(1)
    mark = re.search(r"^marker_seen: (\S+)", txt, re.M).group(1)
    ec = re.search(r"^exit_code: (\S+)", txt, re.M).group(1)
    per[test]["runs"] += 1
    per[test]["uvm_error"] += uvm_e
    per[test]["uvm_fatal"] += uvm_f
    per[test]["cocotb_failed"] += cf
    per[test]["cocotb_passed"] += cp
    per[test]["slow_rounds"] += rounds
    per[test]["timed_out"] += (to == "true")
    per[test]["finish_seen"] += (fin == "true")
    per[test]["marker_seen"] += (mark == "true")
    per[test]["exit0"] += (ec == "0")
print("missing result.yaml:", missing)
for t in sorted(per):
    c = per[t]
    print(f"{t}: runs {c['runs']}  UVM_ERROR {c['uvm_error']}  UVM_FATAL {c['uvm_fatal']}  "
          f"cocotb failed {c['cocotb_failed']} passed {c['cocotb_passed']}  slow rounds {c['slow_rounds']}  "
          f"timed_out {c['timed_out']}  finish_seen {c['finish_seen']}/{c['runs']}  "
          f"marker_seen {c['marker_seen']}/{c['runs']}  exit0 {c['exit0']}/{c['runs']}")

