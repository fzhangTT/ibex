--- gen_report_slice_check.py sha256 20043e2e7e13dc331f0a593bcdac6d0ebac7f2bd5ca6486592e714545cacc4b9 ---
"""Every op's report slice must be its OWN words: reports[rep : rep+len(expects)] == expects.

The check that would have caught the binv-pair regression without a simulation. An op that stops
storing a word while still declaring one makes every later slice read its neighbour's value, and the
entry's fire checks then compare one op's expectation against another op's result.

Usage: python3 gen_report_slice_check.py [--seeds 40]. Exit 0 when every slice matches.
"""
import argparse, sys
from dv.auto_dv.tests.gen_programs import gen_bit_ratified_prog as prog

ap = argparse.ArgumentParser(); ap.add_argument("--seeds", type=int, default=40)
a = ap.parse_args()
bad = []
for seed in range(1, a.seeds + 1):
    p = prog.plan(seed)
    for op in p.ops:
        got = p.reports[op.rep:op.rep + len(op.expects)]
        if got != op.expects:
            bad.append(f"seed {seed} op {op.idx} {op.kind}: slice {[hex(x) for x in got]} "
                       f"is not its own {[hex(x) for x in op.expects]}")
print(f"seeds {a.seeds}, ops checked, mismatching slices {len(bad)}")
for b in bad[:4]:
    print("  " + b)
print("REPORT-SLICE: " + ("PASS" if not bad else "FAIL"))
sys.exit(1 if bad else 0)
--- end gen_report_slice_check.py ---
--- gen_binv_pair_check.py sha256 686bf130af6e6a857543479733eb8fd2c37e478ee1dfbda47de00695614f4386 ---
"""Assert the binv-twice pair retires as CONSECUTIVE records, which is what its bin requires.

The sampler's rule is over consecutive retired records: gen_fcov_pkg.sv:1573 sets `twice` only when the
previous sbit record was a binv on the same rd and index, and its caller at :2578 clears that state on
ANY record that is not an sbit op. So one instruction between the two binvi ops -- the first op's own
report store, in the emitted program -- defeats the bin.

This reads the EMITTED TEXT, not the plan: the plan says the pair is adjacent and the plan is not what
retires. Usage: python3 gen_binv_pair_check.py [--seeds 40]. Exit 0 when every seed's pair is
consecutive, 1 otherwise.
"""
import argparse
import re
import sys

from dv.auto_dv.tests.gen_programs import gen_bit_ratified_prog as prog

INSN = re.compile(r"^\s{2}(?!#)(\S+)")          # an emitted instruction line, not a comment
BINVI = re.compile(r"^\s+binvi\s+x(\d+),\s*x(\d+),\s*(\d+)\s*$")


def pair_of(text):
    """The (index, rd, idx) of each binvi in the emitted instruction stream, comments dropped."""
    out = []
    n = 0
    for line in text.split("\n"):
        if not line.startswith("  ") or line.lstrip().startswith("#") or not line.strip():
            continue
        n += 1
        m = BINVI.match(line)
        if m:
            out.append((n, int(m.group(1)), int(m.group(3))))
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--seeds", type=int, default=40)
    a = ap.parse_args()
    fails, checked = [], 0
    for seed in range(1, a.seeds + 1):
        p = prog.plan(seed)
        pair = [op for op in p.ops if op.tags.get("case", "").startswith("binv_twice")]
        if len(pair) != 2:
            fails.append(f"seed {seed}: expected two binv_twice ops in the plan, found {len(pair)}")
            continue
        first, second = pair
        if not (first.rd == second.rd and first.imm == second.imm):
            fails.append(f"seed {seed}: the pair is not on one rd and index: {first.rd}/{first.imm} vs {second.rd}/{second.imm}")
            continue
        text = prog.emit(p)
        seen = [t for t in pair_of(text) if t[1] == first.rd and t[2] == first.imm]
        checked += 1
        if len(seen) < 2:
            fails.append(f"seed {seed}: fewer than two emitted binvi on x{first.rd} index {first.imm}")
            continue
        # the two the plan means are the adjacent-in-plan ones; find the closest emitted gap
        gaps = [seen[i + 1][0] - seen[i][0] for i in range(len(seen) - 1)]
        if min(gaps) != 1:
            fails.append(f"seed {seed}: the pair on x{first.rd} index {first.imm} is {min(gaps)} instructions apart, "
                         f"not consecutive; the sampler's rule needs no record between them")
    print(f"seeds {a.seeds}, pairs checked {checked}, failures {len(fails)}")
    for f in fails[:10]:
        print("  " + f)
    print("BINV-PAIR-CONSECUTIVE: " + ("PASS" if not fails else "FAIL"))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
--- end gen_binv_pair_check.py ---
