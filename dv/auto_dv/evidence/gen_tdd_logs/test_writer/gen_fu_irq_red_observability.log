================================================================================================
THE CHECKER, in full
================================================================================================
"""Assert that the irq entry's designed fault is OBSERVABLE through the entry's own check.

The red-observability half of the generator hand-off rule for gen_irq_basic_prog.py (Critic L-6).
Three disciplines, all of them model level, no simulation:

  * The predicate is the ENTRY'S OWN line_facts, imported from gen_test_irq_basic, not a copy of it
    written here: a check that drifts from the test would pass this and miss the real thing.
  * Every seed and every red item, because a fault that is observable at most seeds is a red
    fixture that passes at the rest, which the flow reads as "red fixture passed unexpectedly".
  * A control per claim: the green stream must satisfy every fact, and the red must fail exactly
    one fact on exactly one vector, so a checker that failed everything would not pass this.

Usage: python3 gen_irq_red_check.py [--seeds 40]
Exit 0 when every seed and item is observable with its controls, 1 otherwise.
"""
import argparse
import re
import sys

from dv.auto_dv.tests import gen_test_irq_basic as test
from dv.auto_dv.tests.gen_programs import gen_irq_basic_prog as prog

SPIN = 0x8000_0154          # any address: the stream is synthetic and mepc is not what the red moves
NOMINAL_MSTATUS = test.MSTATUS_MPIE | test.MSTATUS_MPP_M      # MIE clear, MPIE set, MPP = M
LINE_CAUSES = (prog.CAUSE_SOFTWARE, prog.CAUSE_TIMER, prog.CAUSE_EXTERNAL) + prog.FAST_CAUSES


DEVIATION_END = "gen_irq_no_red:"


def deviation_vectors(text, armed):
    """Which armed vectors the EMITTED program deviates on, read from the text it emits.

    The fault is not modelled here: it is parsed. A block this reader does not recognise raises,
    because a guess about an unfamiliar guard would turn an unobservable red into a pass.
    """
    if DEVIATION_END not in text:
        return set()
    head = text.index("  csrr t1, mstatus")
    body = text[head:text.index(DEVIATION_END, head) + len(DEVIATION_END)]
    lines = [l.strip() for l in body.split("\n")[1:] if l.strip()]
    m = re.match(r"^li\s+t2,\s*(\d+)$", lines[0] or "")
    shape = [
        lines[1] == "bne  a3, t2, gen_irq_no_red",
        lines[2] == "li   t2, 0x80000000",
        lines[3] == "xor  a4, a4, t2",
        lines[4] == DEVIATION_END,
        len(lines) == 5,
    ]
    if not m or not all(shape):
        raise ValueError("unrecognised deviation block: " + " / ".join(lines[:6]))
    return {int(m.group(1))} & armed if int(m.group(1)) in armed else {int(m.group(1))}


def stream(p, deviate_on=()):
    """The report words a correct device produces for this program, with the emitted fault in.

    The handler stores (vector, mcause, mepc, mtval, mstatus) per entry between the armed marker and
    the final unexpected-trap count. On a deviating vector the program XORs bit 31 out of the mcause
    it reports, which is the whole of the injected fault.
    """
    words = [0xA5A5_0001]
    for e in p.entries:
        mcause = prog.MCAUSE_INTERRUPT | e.cause
        if e.cause in deviate_on:
            mcause ^= prog.MCAUSE_INTERRUPT
        words += [e.cause, mcause, SPIN, 0, NOMINAL_MSTATUS]
    words.append(0)
    return words


def facts_false(reports, cause):
    return [d for ok, d in test.line_facts(reports, cause, "probe") if not ok]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--seeds", type=int, default=40)
    a = ap.parse_args()
    fails, checks = [], 0

    for seed in range(1, a.seeds + 1):
        green = prog.plan(seed)
        armed = {e.cause for e in green.entries}

        # CONTROL 1: the green stream satisfies every fact on every armed line, so a red below is
        # the program's fault and not a defect of this stream.
        for cause in LINE_CAUSES:
            checks += 1
            bad = facts_false(stream(green), cause)
            if bad:
                fails.append(f"seed {seed}: GREEN control fails on cause {cause}: {bad[0]}")

        for item in prog.RED_ITEMS:
            vec = prog.RED_VECTOR[item]
            p = prog.plan(seed, red=True, red_item=item)
            checks += 1
            if p.red_item != item:
                fails.append(f"seed {seed} {item}: plan returned red_item {p.red_item}")
            # the fault is unreachable unless the vector it is pinned to is armed at this seed
            checks += 1
            if vec not in armed:
                fails.append(f"seed {seed} {item}: red vector {vec} is not armed, the fixture is vacuous")

            red_text, green_text = prog.emit(p), prog.emit(green)
            checks += 1
            try:
                applied = deviation_vectors(red_text, armed)
            except ValueError as exc:
                fails.append(f"seed {seed} {item}: {exc}")
                continue
            checks += 1
            if not applied:
                fails.append(f"seed {seed} {item}: the emitted red injects no fault at all")
                continue
            checks += 1
            if applied != {vec}:
                fails.append(f"seed {seed} {item}: the emitted fault applies to {sorted(applied)}, not to {{{vec}}}")

            words = stream(p, deviate_on=applied)
            checks += 1
            bad = facts_false(words, vec)
            if len(bad) != 1 or "carried mcause" not in bad[0]:
                fails.append(f"seed {seed} {item}: the red vector's failing facts are {bad}")
            # ATTRIBUTABLE: no other line class may fail, or the red would not name one fire method
            for cause in LINE_CAUSES:
                if cause == vec:
                    continue
                checks += 1
                other = facts_false(words, cause)
                if other:
                    fails.append(f"seed {seed} {item}: cause {cause} also fails: {other[0]}")

            checks += 1
            if deviation_vectors(green_text, armed):
                fails.append(f"seed {seed} {item}: the emitted GREEN carries a deviation block")

        # the unnamed red draws one of the four items, so the flow's default red is one of these
        checks += 1
        if prog.plan(seed, red=True).red_item not in prog.RED_ITEMS:
            fails.append(f"seed {seed}: the drawn red item is outside RED_ITEMS")

    print(f"seeds {a.seeds}, items {len(prog.RED_ITEMS)}, armed lines per seed {len(LINE_CAUSES)}")
    print(f"checks {checks}, failures {len(fails)}")
    for f in fails[:40]:
        print("  " + f)
    print("RED-OBSERVABILITY: " + ("PASS" if not fails else "FAIL"))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
