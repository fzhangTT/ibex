"""Red and green for the retirement-floor identity, on a real image and two real plan values.

The image carries the number its generator computed (gen_min_retired) and the caller's plan
recomputes it, so a matched pair gives one number twice. This runs both libraries over the same
image: the committed one, whose caller compares with >=, and the one with the identity applied.

Run from the clone root with PYTHONPATH unset; the second argument is a copy of the committed
gen_test_lib.py (git show HEAD:dv/auto_dv/tests/gen_test_lib.py > <path>).

  python3 gen_floor_identity_proof.py <image .vmem> <committed gen_test_lib.py>
"""
import importlib.util
import sys

BUILT, STALE = 3332, 3065     # the image's own generator, and the committed generator at the same seed


def main():
    vmem, head_lib = sys.argv[1], sys.argv[2]
    sys.path.insert(0, "/localdev/fzhang/ws/ibex-challenge")
    from dv.auto_dv.gen_tb.gen_image import GenImage
    from dv.auto_dv.tests import gen_test_lib as applied     # the tree, with the guard applied
    spec = importlib.util.spec_from_file_location("head_lib", head_lib)
    head = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(head)

    img = GenImage(vmem)
    print("THE PAIR: an image whose gen_min_retired word is %d, and a plan that recomputes %d." % (BUILT, STALE))
    print("Both numbers are real: the image was built from the pre-fix generator, the plan is the")
    print("committed generator's at the same seed. A matched pair gives %d twice." % BUILT)
    print("")
    print("RED, the committed library (gen_test_lib.py at HEAD):")
    f = head.program_min_retired(img)
    print("  program_min_retired(image) -> %d, and the caller's check is 'retired >= floor >= plan'" % f)
    print("  the mismatched pair reaches that check as %d >= %d -> %s   <- the fault escapes"
          % (f, STALE, f >= STALE))
    print("")
    print("GREEN, the library with the guard applied:")
    print("  no plan given             -> %d   (unchanged: riscv-dv entries and any caller that passes none)"
          % applied.program_min_retired(img))
    print("  matched plan %d         -> %d   (passes)" % (BUILT, applied.program_min_retired(img, BUILT)))
    try:
        applied.program_min_retired(img, STALE)
    except AssertionError as exc:
        print("  MISMATCHED plan %d      -> AssertionError:" % STALE)
        for line in str(exc).split("\n"):
            print("      " + line.strip())
        return 0
    print("  MISMATCHED plan %d      -> returned; THE GUARD FAILED" % STALE)
    return 1


if __name__ == "__main__":
    sys.exit(main())
