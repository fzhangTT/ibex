#!/usr/bin/env python3
"""rt39 item four RED + POSITIVE CONTROL, both on real committed data.

Control: the committed round-0 pair really did share sources, so the flag must read true on it.
Red:     a canary whose sources differ must record BOTH values and a false flag, where the
         pre-change canary_build_facts records neither value at all.
"""
import sys, tempfile
sys.path.insert(0, "/localdev/fzhang/ws/ibex-challenge/dv/auto_dv/flow")
import gen_flow_util as U, gen_flow_const as C
from pathlib import Path

ev = C.EVIDENCE_DIR / "gen_round_0"
round_man = U.load_yaml(ev / "gen_build_manifest_gen_tb.yaml")
round_sources = (round_man.get("inputs") or {}).get("sources_sha256")
print(f"round-0 build record sources_sha256 = {round_sources[:24]}...")

# Scratch under the flow's own self-test root, never the shared /tmp (gen_flow_const F-001).
d = Path(tempfile.mkdtemp(prefix="rt39_item4_", dir=C.selftest_tmp()))
ok = True

# Positive control: a canary manifest with the round's own digest.
U.dump_yaml(round_man, d / C.BUILD_MANIFEST)
facts = U.canary_build_facts(d)
same = facts.get("sources_sha256") == round_sources
match = (facts.get("sources_sha256") == round_sources)
ok &= same
print(f"{'ok  ' if same else 'BAD '} POSITIVE CONTROL: canary_build_facts carries the digest "
      f"({str(facts.get('sources_sha256'))[:16]}), compare result {match}")
print(f"     scope recorded: {facts.get('sources_sha256_scope')}")

# Red: a canary built from different sources.
other = dict(round_man)
other["inputs"] = dict(round_man["inputs"], sources_sha256="f" * 64)
U.dump_yaml(other, d / C.BUILD_MANIFEST)
facts2 = U.canary_build_facts(d)
differs = facts2.get("sources_sha256") == "f" * 64 and facts2.get("sources_sha256") != round_sources
ok &= differs
print(f"{'ok  ' if differs else 'BAD '} RED: a canary of other sources records its OWN digest "
      f"({str(facts2.get('sources_sha256'))[:16]}), so the compare result would be False, not silent")

# What the pre-change record showed: the committed index entry contains the digest zero times.
idx = U.load_yaml(C.ROUND_INDEX)
entry = idx["rounds"][-1]
absent = round_sources not in str(entry)
ok &= absent
print(f"{'ok  ' if absent else 'BAD '} PRE-CHANGE DEFECT, measured on the committed index: the round-0 entry "
      f"contains the sources digest {0 if absent else 1} time(s); its canary_build keys are "
      f"{sorted((entry.get('canary_build') or {}))}")
U.remove_tree_guarded(d, (Path(C.selftest_tmp()),), "item four self-test dir")
print("ITEM FOUR:", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 2)

