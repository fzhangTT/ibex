#!/usr/bin/env python3
"""rt39 item one, the planned FIRST red: the manifest, the round summary row and the dashboard row must
name ONE group quantity. Runs the three consumers over one coverage record and compares their cells.

Input: the committed round-0 regression manifest's coverage record, with group_quantities supplied by the
landed parse of the committed gen_groups.txt (the record predates the field). Red: one consumer forced to a
different field must be caught."""
import sys, copy
sys.path.insert(0, "/localdev/fzhang/ws/ibex-challenge/dv/auto_dv/flow")
import gen_cov_report as R, gen_flow_const as C, gen_flow_util as U
import gen_round as RD, gen_dashboard as DB

ev = C.EVIDENCE_DIR / "gen_round_0"
cov = (U.load_yaml(ev / "gen_regress_manifest.yaml").get("coverage") or {})
rows = R.parse_groups((ev / "gen_groups.txt").read_text())
cov["group_quantities"] = R.group_quantities(rows, cov.get("totals") or {}, C.LEDGER_COVERGROUPS)

def cells(c):
    return {"manifest": R.group_cell(c.get("group_quantities") or {}),
            "round_summary": RD.metric_row(c)["group_cell"],
            "dashboard": DB.dut_scope_row({"coverage": c})["group_cell"]}

def judge(label, c, want_equal):
    got = cells(c)
    keys = ("field", "percent", "ratio", "scope")
    view = {k: {kk: v.get(kk) for kk in keys} for k, v in got.items()}
    same = len({tuple(sorted(v.items())) for v in view.values()}) == 1
    ok = same is want_equal
    print(f"SELF-TEST {'ok ' if ok else 'BAD'} {label}: identical={same} (want {want_equal})")
    for k, v in view.items():
        print(f"      {k:14} field={v['field']} percent={v['percent']} ratio={v['ratio']} scope={str(v['scope'])[:64]}")
    return ok

ok = judge("three consumers over one record agree", copy.deepcopy(cov), True)
red = copy.deepcopy(cov)
orig = R.group_cell
try:
    # ONE consumer made to name another quantity, which is the pre-change shape where each module chose for
    # itself. The three consumers share one module object, so the divergent one is picked out by its caller
    # frame rather than by patching a per-module binding, which would move all three at once.
    import inspect

    def divergent(q, field=None):
        caller = inspect.currentframe().f_back.f_globals.get("__name__")
        return orig(q, "group_bins_gate" if caller == "gen_dashboard" else field)
    R.group_cell = divergent
    ok &= judge("RED, the dashboard alone naming another quantity is CAUGHT", red, False)
finally:
    R.group_cell = orig
print("IDENTITY CHECK:", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 2)

