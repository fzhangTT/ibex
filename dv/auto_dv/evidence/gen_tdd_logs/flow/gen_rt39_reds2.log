# red_item5.py  md5 bc05dc6b3c94a9e38c3e6fcd260c6d31  2191 bytes
----------------------------------------------------------------
#!/usr/bin/env python3
"""rt39 item five RED: the retention shape must be reproducible.

Runs the SAME assertion against two retention implementations:
  control  = the expression gen_round.py:232 uses today, gzip.open(dst, "wb")
  changed  = gzip.GzipFile(fileobj=..., filename="", mtime=0)
A gzip member's header is: magic(2) CM(1) FLG(1) MTIME(4, little-endian) XFL(1) OS(1).
FLG bit 3 (0x08, FNAME) set means the source file name is stored in the member.
"""
import gzip, hashlib, shutil, struct, sys, tempfile
from pathlib import Path


def retain_control(src: Path, dst: Path) -> None:
    with src.open("rb") as s, gzip.open(dst, "wb") as d:      # gen_round.py:232 today
        shutil.copyfileobj(s, d)


def retain_changed(src: Path, dst: Path) -> None:
    with src.open("rb") as s, dst.open("wb") as fh, \
            gzip.GzipFile(fileobj=fh, filename="", mtime=0, mode="wb") as d:
        shutil.copyfileobj(s, d)


def facts(p: Path) -> tuple[int, bool, str]:
    h = p.read_bytes()[:10]
    mtime = struct.unpack("<I", h[4:8])[0]
    fname_flag = bool(h[3] & 0x08)
    return mtime, fname_flag, hashlib.sha256(p.read_bytes()).hexdigest()


def check(name, fn, d: Path) -> bool:
    src = d / "modlist.txt"
    src.write_bytes(b"module top\nmodule leaf\n" * 300)
    a, b = d / f"{name}_a.gz", d / f"{name}_b.gz"
    fn(src, a)
    fn(src, b)
    m_a, f_a, s_a = facts(a)
    m_b, f_b, s_b = facts(b)
    ok = (m_a == 0 and m_b == 0 and not f_a and not f_b and s_a == s_b)
    print(f"SELF-TEST {'ok  ' if ok else 'BAD '} item5 retention reproducible [{name}]: "
          f"mtime {m_a}/{m_b}, stored-name flag {f_a}/{f_b}, digests {'equal' if s_a == s_b else 'DIFFER'} "
          f"({s_a[:12]} {s_b[:12]})")
    return ok


d = Path(tempfile.mkdtemp(prefix="rt39_item5_"))
control_ok = check("control", retain_control, d)
changed_ok = check("changed", retain_changed, d)
shutil.rmtree(d)
print()
print("RED  (control, the shape gen_round.py:232 writes today):", "PASS - NO RED" if control_ok else "FAILS as required")
print("GREEN(changed, filename='' mtime=0):", "PASSES" if changed_ok else "FAILS - the fix is wrong")
sys.exit(0 if (not control_ok and changed_ok) else 2)

