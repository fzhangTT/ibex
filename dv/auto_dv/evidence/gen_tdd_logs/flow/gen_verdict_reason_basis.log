#!/usr/bin/env python3
"""RED for the verdict-reason item: the earliest failing line of a VCS assertion failure is the Offending
continuation, which names no mechanism, and the reason carries only its class and position while the very
next line names the property."""
import sys
sys.path.insert(0, "/localdev/fzhang/ws/ibex-challenge/dv/auto_dv/flow")
import gen_verdict as V, gen_flow_const as C

# The real shape, taken verbatim from the 258-fire run's sim.log lines 44-46 with the paths shortened.
LINES = [
    "UVM_INFO @ 229500: reporter [GEN_EOT] end-of-test store 0xa5c30001 at 0x8ffff104 (store 1)",
    '"gen_protocol_props.sv", 299: gen_tb_top.u_dut.gen_protocol_props_i.sva_rvfi_irq_valid_exclusive: started at 65915000ps failed at 65915000ps',
    "\tOffending '(!rvfi_valid)'",
    "UVM_ERROR @ 6591500: reporter [sva_rvfi_irq_valid_exclusive] GEN_PROTO sva_rvfi_irq_valid_exclusive: protocol property violated at cycle 6587",
    "GEN_TEST_PASS",
]
res = V.decide_lines(LINES, "GEN_TEST_PASS", False, 0, C.BUILD_CONFIG, [])
print("verdict :", res["verdict"])
print("reason  :", res["reason"])
print("evidence:", res["evidence"].strip())
named = "sva_rvfi_irq_valid_exclusive" in res["reason"]
print("SELF-TEST", "ok " if named else "BAD", "the reason names the property that fired:", named)

# Control: an unrelated error far below the hit must NOT be attributed to it.
FAR = LINES[:3] + ["filler"] * 12 + [
    "UVM_ERROR @ 9999999: reporter [some_other_thing] unrelated",
    "GEN_TEST_PASS",
]
res2 = V.decide_lines(FAR, "GEN_TEST_PASS", False, 0, C.BUILD_CONFIG, [])
print("CONTROL reason:", res2["reason"])
far_ok = "some_other_thing" not in res2["reason"]
print("SELF-TEST", "ok " if far_ok else "BAD", "a distant unrelated error is not attributed:", far_ok)
sys.exit(0 if (named and far_ok) else 2)

