#!/usr/bin/env python3
"""Re-decide every non-fcov failure of the wave regression with the changed verdict and compare.

Run root: /proj_soc/user_dev/fzhang/ibex_dv_out/regress_wave_4017573/runs (403 run directories).
fcov-expectation failures are excluded because their reason comes from the coverage checker, not the log scan.
Each run is re-decided with the arguments the ORIGINAL run had, red_fixture and red_expect included; omitting
those two regrades a RED-OK fixture as a plain FAIL and reports a false verdict change."""
import sys, os, re, yaml, pathlib, collections
sys.path.insert(0, "/localdev/fzhang/ws/ibex-challenge/dv/auto_dv/flow")
import gen_verdict as V, gen_flow_const as C
R = pathlib.Path("/proj_soc/user_dev/fzhang/ibex_dv_out/regress_wave_4017573/runs")
same = chg = gained = 0; names = collections.Counter(); kept = []
for d in sorted(os.listdir(R)):
    rp = R / d / "result.yaml"
    if not rp.is_file():
        continue
    old = yaml.safe_load(open(rp))
    if old["verdict"] == "PASS" or old["reason"].startswith("fcov expectation"):
        continue
    res = V.decide(R / d / "sim.log", old.get("pass_marker") or "GEN_TEST_PASS", False, False,
                   old.get("exit_code"), extra_logs=[R / d / "sim_stdout.log"], build_config=C.BUILD_CONFIG,
                   stderr_logs=[], red_fixture=bool(old.get("red_fixture")), red_expect=old.get("red_expect"))
    same += res["verdict"] == old["verdict"]; chg += res["verdict"] != old["verdict"]
    if res["reason"] != old["reason"]:
        gained += 1
        m = re.search(r"\(([A-Za-z_]\w*)\)", res["reason"])
        if m:
            names[m.group(1)] += 1
    else:
        kept.append((d, res["reason"][:70]))
print(f"non-fcov failures re-decided: {same + chg}")
print(f"  verdict unchanged: {same}    verdict changed: {chg}")
print(f"  reasons that gained a mechanism name: {gained}")
for k, v in names.most_common():
    print(f"     {v:3d}  {k}")
print(f"  reasons unchanged (no UVM id within the window): {len(kept)}")
for d, r in kept:
    print(f"     {d}: {r}")

