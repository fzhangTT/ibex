+        if (!cfg.is_data && (cycle % 250) == 0) $display("MUT-PHANTOMGRANT2 census at cycle %0d: req-low %0d req-low-with-fills %0d grants %0d", cycle, mut_a_reqlow, mut_a_reqlow_busy, mut_a_req_hi);   // MUT-PHANTOMGRANT2
